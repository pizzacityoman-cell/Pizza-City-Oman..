{
  "name": "pizza-city-oman",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:legacy": "NODE_OPTIONS=--openssl-legacy-provider tsx server.ts",
    "build:client": "vite build",
    "build:netlify": "vite build && node scripts/prerender-seo.mjs",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/server.js",
    "build": "npm run build:client && npm run build:server",
    "start": "NODE_ENV=production node dist/server.js",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "migrate:media": "tsx scripts/migrate-cloudinary-to-cloudflare.ts",
    "migrate:media:dry": "tsx scripts/migrate-cloudinary-to-cloudflare.ts --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "mongodb": "^7.5.0",
    "mongoose": "^9.6.3",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-phone-number-input": "^3.4.17",
    "react-router-dom": "^6.22.3",
    "sharp": "^0.35.4",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
