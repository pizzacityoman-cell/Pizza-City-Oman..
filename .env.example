# Required — JWT signing key for auth tokens (generate a strong random string)
JWT_SECRET=

# Required — separate signing key for refresh tokens (must differ from JWT_SECRET)
JWT_REFRESH_SECRET=

# Required for admin login fallback (when MongoDB is unavailable)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# MongoDB connection string (optional — falls back to in-memory storage if unset)
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# Cloudflare R2 media storage (required for admin banner/menu image uploads)
# Get these from Cloudflare dashboard -> R2 -> Manage R2 API Tokens + bucket public URL
# NEVER put real secrets in this file — copy them into your local (gitignored) .env instead.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=

# Frontend origin for CORS (optional — defaults to https://pizzacityoman.com)
# ALLOWED_ORIGIN=https://pizzacityoman.com
